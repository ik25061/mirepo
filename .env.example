# ========================================
# CONFIGURACIÓN DEL SERVIDOR - PLANTILLA
# ========================================
# Copia este archivo a .env y modifica los valores según tu entorno

# Puerto del servidor backend (Express)
VITE_SERVER_PORT=5002

# Puerto del cliente/frontend (Vite)
VITE_CLIENT_PORT=5172

# Ruta a la carpeta de música (relativa al directorio actual o absoluta)
# Ejemplo en Windows: E:\musica
# Ejemplo en Linux/Mac: /home/usuario/Musica
VITE_MUSIC_PATH=D:/music

# IP del servidor para acceso desde redes externas
# Déjalo vacío (o comentado) para usar detección automática de IP
# Útil cuando accedes desde móviles u otras máquinas en la red
# Si tienes múltiples redes, usa la IP que necesites para esa red
# VITE_SERVER_HOST=192.168.1.88
